import java.util.*;

public class SmartLibrarySearchSystem {

    static int V = 5;

    static void BFS(List<List<Integer>> graph, int start) {

        boolean visited[] = new boolean[V];
        Queue<Integer> queue = new LinkedList<>();

        visited[start] = true;
        queue.add(start);

        System.out.print("BFS Traversal: ");

        while (!queue.isEmpty()) {

            int node = queue.poll();
            System.out.print(node + " ");

            for (int neighbor : graph.get(node)) {

                if (!visited[neighbor]) {
                    visited[neighbor] = true;
                    queue.add(neighbor);
                }
            }
        }
        System.out.println();
    }

    static void DFSUtil(List<List<Integer>> graph, int node,
                        boolean visited[]) {

        visited[node] = true;
        System.out.print(node + " ");

        for (int neighbor : graph.get(node)) {

            if (!visited[neighbor]) {
                DFSUtil(graph, neighbor, visited);
            }
        }
    }

    static void DFS(List<List<Integer>> graph, int start) {

        boolean visited[] = new boolean[V];

        System.out.print("DFS Traversal: ");
        DFSUtil(graph, start, visited);
        System.out.println();
    }

    static int primMST(int graph[][]) {

        int parent[] = new int[V];
        int key[] = new int[V];
        boolean mstSet[] = new boolean[V];

        Arrays.fill(key, Integer.MAX_VALUE);

        key[0] = 0;
        parent[0] = -1;

        for (int count = 0; count < V - 1; count++) {

            int min = Integer.MAX_VALUE;
            int u = -1;

            for (int v = 0; v < V; v++) {

                if (!mstSet[v] && key[v] < min) {
                    min = key[v];
                    u = v;
                }
            }

            mstSet[u] = true;

            for (int v = 0; v < V; v++) {

                if (graph[u][v] != 0 &&
                        !mstSet[v] &&
                        graph[u][v] < key[v]) {

                    parent[v] = u;
                    key[v] = graph[u][v];
                }
            }
        }

        int totalCost = 0;

        for (int i = 1; i < V; i++) {
            totalCost += graph[i][parent[i]];
        }

        return totalCost;
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        String[] categories = {
                "Data Structures",
                "Algorithms",
                "Database Systems",
                "Operating Systems",
                "Computer Networks"
        };

        System.out.println("SMART LIBRARY SEARCH SYSTEM");
        System.out.println("\nBook Categories:");

        for (int i = 0; i < categories.length; i++) {
            System.out.println(i + " - " + categories[i]);
        }

        List<List<Integer>> graph = new ArrayList<>();

        for (int i = 0; i < V; i++) {
            graph.add(new ArrayList<>());
        }

        graph.get(0).add(1);
        graph.get(0).add(4);

        graph.get(1).add(0);
        graph.get(1).add(2);

        graph.get(2).add(1);
        graph.get(2).add(3);

        graph.get(3).add(2);
        graph.get(3).add(4);

        graph.get(4).add(0);
        graph.get(4).add(3);

        int weightedGraph[][] = {
                {0, 2, 0, 0, 6},
                {2, 0, 3, 0, 0},
                {0, 3, 0, 4, 0},
                {0, 0, 4, 0, 5},
                {6, 0, 0, 5, 0}
        };

        System.out.print("\nEnter Starting Category Index: ");
        int start = sc.nextInt();

        BFS(graph, start);

        DFS(graph, start);

        int mstCost = primMST(weightedGraph);

        System.out.println("\nMinimum Cost using Prim's MST = " + mstCost);

        sc.close();
    }
}
