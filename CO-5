import java.util.Scanner;

class Book {
    int bookId;
    String bookTitle;

    Book(int bookId, String bookTitle) {
        this.bookId = bookId;
        this.bookTitle = bookTitle;
    }
}

public class SmartLibrarySearchSystem {

    static void merge(Book books[], int left, int mid, int right) {

        int n1 = mid - left + 1;
        int n2 = right - mid;

        Book L[] = new Book[n1];
        Book R[] = new Book[n2];

        for (int i = 0; i < n1; i++)
            L[i] = books[left + i];

        for (int j = 0; j < n2; j++)
            R[j] = books[mid + 1 + j];

        int i = 0, j = 0;
        int k = left;

        while (i < n1 && j < n2) {

            if (L[i].bookId <= R[j].bookId) {
                books[k] = L[i];
                i++;
            } else {
                books[k] = R[j];
                j++;
            }
            k++;
        }

        while (i < n1) {
            books[k] = L[i];
            i++;
            k++;
        }

        while (j < n2) {
            books[k] = R[j];
            j++;
            k++;
        }
    }

    static void mergeSort(Book books[], int left, int right) {

        if (left < right) {

            int mid = (left + right) / 2;

            mergeSort(books, left, mid);
            mergeSort(books, mid + 1, right);

            merge(books, left, mid, right);
        }
    }

    static void displayBooks(Book books[]) {

        System.out.println("\n-------------------------------");
        System.out.println("Sorted Library Book Records");
        System.out.println("-------------------------------");

        System.out.printf("%-10s %-30s\n", "Book ID", "Book Title");

        for (Book b : books) {
            System.out.printf("%-10d %-30s\n", b.bookId, b.bookTitle);
        }
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.println("========================================");
        System.out.println(" SMART LIBRARY SEARCH SYSTEM");
        System.out.println(" Using Merge Sort Algorithm");
        System.out.println("========================================");

        System.out.print("\nEnter Number of Books : ");
        int n = sc.nextInt();
        sc.nextLine();

        Book books[] = new Book[n];

        for (int i = 0; i < n; i++) {

            System.out.println("\nEnter Details of Book " + (i + 1));

            System.out.print("Book ID : ");
            int id = sc.nextInt();
            sc.nextLine();

            System.out.print("Book Title : ");
            String title = sc.nextLine();

            books[i] = new Book(id, title);
        }

        System.out.println("\nBook Records Before Sorting");
        System.out.println("-------------------------------");

        System.out.printf("%-10s %-30s\n", "Book ID", "Book Title");

        for (Book b : books) {
            System.out.printf("%-10d %-30s\n", b.bookId, b.bookTitle);
        }

        long startTime = System.nanoTime();

        mergeSort(books, 0, n - 1);

        long endTime = System.nanoTime();

        displayBooks(books);

        System.out.println("\nExecution Time : " + (endTime - startTime) + " nanoseconds");

        sc.close();
    }
}
