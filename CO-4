import java.util.Arrays;

public class SmartLibrarySearchSystem {

    static final int V = 6;
    static final int INF = Integer.MAX_VALUE;

    // Find the vertex with the minimum distance
    static int minDistance(int dist[], boolean visited[]) {
        int min = INF;
        int minIndex = -1;

        for (int i = 0; i < V; i++) {
            if (!visited[i] && dist[i] < min) {
                min = dist[i];
                minIndex = i;
            }
        }
        return minIndex;
    }

    // Print the shortest path
    static void printPath(int parent[], int j, String[] sections) {
        if (parent[j] == -1) {
            System.out.print(sections[j]);
            return;
        }

        printPath(parent, parent[j], sections);
        System.out.print(" -> " + sections[j]);
    }

    // Dijkstra's Algorithm
    static void dijkstra(int graph[][], int src, String[] sections) {

        int dist[] = new int[V];
        boolean visited[] = new boolean[V];
        int parent[] = new int[V];

        Arrays.fill(dist, INF);
        Arrays.fill(visited, false);

        for (int i = 0; i < V; i++)
            parent[i] = -1;

        dist[src] = 0;

        for (int count = 0; count < V - 1; count++) {

            int u = minDistance(dist, visited);
            visited[u] = true;

            for (int v = 0; v < V; v++) {

                if (!visited[v] &&
                        graph[u][v] != 0 &&
                        dist[u] != INF &&
                        dist[u] + graph[u][v] < dist[v]) {

                    dist[v] = dist[u] + graph[u][v];
                    parent[v] = u;
                }
            }
        }

        System.out.println("\n===== Shortest Routes in Library =====\n");

        for (int i = 0; i < V; i++) {

            System.out.println("Destination : " + sections[i]);
            System.out.println("Distance    : " + dist[i]);

            System.out.print("Path        : ");
            printPath(parent, i, sections);

            System.out.println("\n");
        }
    }

    public static void main(String[] args) {

        String[] sections = {
                "Entrance",
                "Computer Science",
                "Mathematics",
                "Electronics",
                "Reference",
                "Book Shelf"
        };

        // Graph representing library sections
        int graph[][] = {

                {0, 4, 2, 0, 0, 0},
                {4, 0, 1, 5, 0, 0},
                {2, 1, 0, 8, 10, 0},
                {0, 5, 8, 0, 2, 6},
                {0, 0, 10, 2, 0, 3},
                {0, 0, 0, 6, 3, 0}

        };

        System.out.println("==============================================");
        System.out.println(" SMART LIBRARY SEARCH SYSTEM");
        System.out.println(" Using Dijkstra's Shortest Path Algorithm");
        System.out.println("==============================================");

        dijkstra(graph, 0, sections);
    }
}
